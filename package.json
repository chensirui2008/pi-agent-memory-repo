{
  "name": "pi-agent-memory-repo",
  "version": "1.2.0",
  "description": "Cognition spec compliant persistent Git-backed agent memory repo for Pi coding agent",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "keywords": [
    "pi-package",
    "pi",
    "agent-memory",
    "agent-memory-repo",
    "cognition",
    "devin",
    "memory",
    "git-backed-memory"
  ],
  "files": [
    "dist/src",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "skills": [
      "./skills/agent-memory",
      "./skills/agent-memory-repo"
    ]
  },
  "homepage": "https://pi.dev/packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chensirui2008/pi-agent-memory-repo.git"
  },
  "bugs": {
    "url": "https://github.com/chensirui2008/pi-agent-memory-repo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Pi Agent Team",
  "license": "MIT",
  "devDependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-tui": "*"
  },
  "omp": {
    "extensions": [
      "./dist/src/omp.js"
    ],
    "skills": [
      "./skills/agent-memory",
      "./skills/agent-memory-repo"
    ]
  }
}
